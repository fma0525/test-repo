# Story Planet - 環境變數設定
# 複製此檔案為 .env.local 並填入你的 API Key
# cp .env.local.example .env.local

# === Mock 模式（不需要任何 API Key 就能跑）===
# 設為 true 時使用內建假資料，不呼叫任何外部 API
USE_MOCK=true

# === AI 服務 API Keys ===
# 故事文字生成（https://console.anthropic.com）
ANTHROPIC_API_KEY=

# 封面圖生成（https://platform.openai.com）
OPENAI_API_KEY=

# 語音合成（https://elevenlabs.io）
ELEVENLABS_API_KEY=

# === 資料庫 & 儲存 ===
# Supabase（https://supabase.com）
SUPABASE_URL=
SUPABASE_ANON_KEY=
